<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- pos.order inherit form view -->
    <record id="etims_view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.inherit.view.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='extra']" position="inside">
                <group name="etims" string="ETISM">
                    <field name="etims_sdc_date"/>
                    <field name="etims_receipt_sign" widget='image' class="oe_avatar"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>