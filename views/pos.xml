<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- pos.order inherit form view -->
    <record id="vscu_view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.inherit.view.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='extra']" position="inside">
                <group name="vscu" string="VSCU">
                    <field name="vscu_date"/>
                    <field name="vscu_qr_code" widget='image' class="oe_avatar"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">Payment Method</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="after">
                <field name="vscu_sign"/>
            </xpath>
        </field>
    </record>
</odoo>