<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- pos.config inherit form view -->
    <record id="advance_vscu_pos_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.advance_vscu_pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']" position="before">
                <setting id="vscu_tax_setting" string="VSCU Setup" help="Apply VSCU signing on order">
                    <field name="pos_vscu_config"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>            